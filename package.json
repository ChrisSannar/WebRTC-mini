{
  "name": "webrtc-mini",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -w",
    "start": "serve apps/example",
    "lint": "eslint .",
